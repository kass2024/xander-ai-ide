{
  "name": "desktop",
  "version": "1.0.0",
  "description": "Xander AI IDE Desktop Application",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3 || echo native rebuild skipped",
    "preview": "electron-vite preview"
  },
  "keywords": [
    "electron",
    "ide",
    "ai",
    "xander"
  ],
  "author": "Xander AI",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.1",
    "diff": "^9.0.0",
    "lucide-react": "^0.394.0",
    "monaco-editor": "^0.51.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.xander.ai.ide",
    "productName": "Xander AI IDE",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "out/renderer/assets/*worker*",
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xander AI IDE",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
