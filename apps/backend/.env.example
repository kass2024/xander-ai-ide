# =============================================================================
# Xander AI IDE — Backend Environment (copy to .env and fill in values)
# =============================================================================

# --- Database (PostgreSQL) ---
# Install: https://www.postgresql.org/download/
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xander_ai_ide"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# --- Application ---
PORT=3001
NODE_ENV=development
WEB_URL="http://localhost:3000"

# --- Stripe ---
# Keys:    https://dashboard.stripe.com/test/apikeys
# Webhooks: https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- OpenAI (REQUIRED) ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_AGENT="gpt-4o"
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Anthropic Claude (optional) ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# --- Google Gemini (optional) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GOOGLE_AI_MODEL="gemini-2.0-flash"

# --- DeepSeek (optional) ---
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# --- Groq (optional) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Mistral (optional) ---
# Get key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"

# --- LLM provider switch ---
LLM_PROVIDER="openai"

# --- Ollama (optional, local) ---
# Download: https://ollama.com/download
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="codellama"

# --- Redis (optional) ---
REDIS_URL="redis://localhost:6379"

# --- Qdrant (optional) ---
QDRANT_URL="http://localhost:6333"

# --- Rate limiting ---
AI_RATE_LIMIT_PER_MIN=60

# --- Admin user (prisma seed) ---
ADMIN_EMAIL="admin@xander.ai"
ADMIN_PASSWORD="admin123"

# --- Server workspace path ---
WORKSPACE_PATH=""
