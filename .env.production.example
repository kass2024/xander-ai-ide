# Xander AI IDE — Production Environment (Docker VPS)
# Copy to .env.production and fill in secrets before deploy

NODE_ENV=production

# PostgreSQL (docker-compose service names)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=xander_ai_ide
# DATABASE_URL is built automatically in Docker from POSTGRES_* (do not use localhost)

# Redis & Qdrant
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL_AGENT=gpt-5.1
OPENAI_MODEL_FAST=gpt-5.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT — generate: openssl rand -base64 48
JWT_SECRET=change_this_jwt_secret

# Stripe (use live keys in production)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# URLs (VPS domain — use https after SSL setup)
WEB_URL=https://parrotmoc.online
NEXT_PUBLIC_API_URL=https://api.parrotmoc.online

# Let's Encrypt (scripts/setup-ssl-parrotmoc.sh)
CERTBOT_EMAIL=admin@parrotmoc.online
# After SSL: NGINX_CONFIG=./nginx.ssl.conf (setup script sets this)

# Seed plans on first deploy
RUN_SEED=true

# Rate limiting
AI_RATE_LIMIT_PER_MIN=60

# Optional AI providers (copy from local apps/backend/.env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional admin bootstrap (created on seed if set)
ADMIN_EMAIL=admin@parrotmoc.online
ADMIN_PASSWORD=change_this_admin_password
