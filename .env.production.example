# Xander AI IDE — Production Environment (Docker VPS)
# Copy to .env.production and fill in secrets before deploy

NODE_ENV=production

# PostgreSQL (docker-compose service names)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=xander_ai_ide
DATABASE_URL=postgresql://postgres:change_this_strong_password@postgres:5432/xander_ai_ide

# Redis & Qdrant
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL_AGENT=gpt-5.1
OPENAI_MODEL_FAST=gpt-5.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT — generate: openssl rand -base64 48
JWT_SECRET=change_this_jwt_secret

# Stripe (use live keys in production)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# URLs (VPS domain — example: parrotmoc.online)
WEB_URL=https://parrotmoc.online
NEXT_PUBLIC_API_URL=https://api.parrotmoc.online

# Seed plans on first deploy
RUN_SEED=true

# Rate limiting
AI_RATE_LIMIT_PER_MIN=60

# Optional admin bootstrap (created on seed if set)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_admin_password
