# Backend Dockerfile — production
FROM node:20-alpine AS base
RUN apk add --no-cache openssl wget python3 make g++

FROM base AS builder
WORKDIR /app

# Prisma schema must exist before npm install (package.json postinstall runs prisma generate)
COPY apps/backend/package.json apps/backend/package-lock.json* ./
COPY apps/backend/prisma ./prisma

RUN npm install --ignore-scripts
RUN npx prisma generate

COPY apps/backend/ .
RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nodejs

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma
COPY scripts/backend-entrypoint.sh /entrypoint.sh
COPY scripts/build-database-url.cjs /app/build-database-url.cjs
RUN chmod +x /entrypoint.sh && chown -R nodejs:nodejs /app

USER nodejs
EXPOSE 3001
ENV PORT=3001

HEALTHCHECK --interval=15s --timeout=10s --retries=10 --start-period=120s \
  CMD wget -qO- http://localhost:3001/health/live || exit 1

ENTRYPOINT ["/entrypoint.sh"]
